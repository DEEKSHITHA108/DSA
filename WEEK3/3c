N = int(input("Enter number of elements: "))

arr = []

print("Enter elements:")

for i in range(N):
    arr.append(int(input()))

# Selection Sort
for i in range(N - 1):
    min_index = i

    for j in range(i + 1, N):
        if arr[j] < arr[min_index]:
            min_index = j

    # Swap
    arr[i], arr[min_index] = arr[min_index], arr[i]

print("Sorted array:")

for i in range(N):
    print(arr[i])
